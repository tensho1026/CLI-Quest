{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tensho1026/CLI-Quest/schemas/scene.schema.json",
  "title": "CLI Quest Scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "difficulty", "description", "mission", "success", "setup", "validation", "hints"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "difficulty": {"enum": ["easy", "normal", "hard"]},
    "description": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "success": {"type": "string", "minLength": 1},
    "solution": {"type": "array", "items": {"type": "string"}},
    "lesson": {"$ref": "#/$defs/lesson"},
    "setup": {"$ref": "#/$defs/setup"},
    "validation": {"$ref": "#/$defs/validation"},
    "hints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "translations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/localized"}
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string"}, "content": {"type": "string"},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["filesystem", "git_wrong_branch", "git_restore_file", "git_lost_commit", "git_conflict", "git_stash_recovery", "git_bisect", "port_conflict", "runaway_process", "http_server"]},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "mode": {"type": "string"},
        "values": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["all", "any", "executable", "file_exists", "file_mode", "file_contains", "file_not_contains", "git_branch", "git_clean", "git_no_conflicts", "git_file_contains", "git_wrong_branch", "git_commit_contains", "git_bisect_answer", "process_stopped", "port_available", "marker_exists"]},
        "path": {"type": "string"}, "value": {"type": "string"}, "name": {"type": "string"},
        "validators": {"type": "array", "items": {"$ref": "#/$defs/validation"}}
      }
    },
    "lesson": {
      "type": "object", "additionalProperties": false,
      "properties": {"what_happened":{"type":"string"},"other_solutions":{"type":"array","items":{"type":"string"}},"be_careful":{"type":"string"}}
    },
    "localized": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "title":{"type":"string"},"description":{"type":"string"},"mission":{"type":"string"},"success":{"type":"string"},
        "hints":{"type":"array","items":{"type":"string"}},"solution":{"type":"array","items":{"type":"string"}},"lesson":{"$ref":"#/$defs/lesson"}
      }
    }
  }
}
